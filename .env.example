# Copy this file to `.env` (which git ignores) and fill it in, then restart `python -m agents.server`.
# Nothing here is ever sent to the browser page or committed.

# Gmail: "Email me this proposal". Create an App Password at https://myaccount.google.com/apppasswords
# (it needs 2-Step Verification). Use that 16-character password here, never your normal one.
AI_OFFICE_SMTP_USER=you@gmail.com
AI_OFFICE_SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Mail may only go to the address above plus any listed here (comma separated).
# AI_OFFICE_EMAIL_TO=

# GitHub: "Send code to GitHub" opens a pull request with the `gh` CLI (brew install gh, then gh auth login).
# This project's own origin is always allowed; add more repositories here (owner/name, comma separated).
# AI_OFFICE_GITHUB_REPOS=you/another-repo
